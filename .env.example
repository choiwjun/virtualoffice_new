# Docker Compose 환경변수 — 복사: cp .env.example .env (실제 .env는 커밋 금지)
# 사내 로컬 서버 PC 배포용

# ── PostgreSQL (우리 DB) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=virtualoffice
DB_PORT=5432
# 외부 공개 서버(VPN 없음) → DB는 localhost 전용. 절대 0.0.0.0으로 열지 말 것.
DB_BIND=127.0.0.1

# ── 백엔드 ──
BACKEND_PORT=8000
ENVIRONMENT=development
JWT_SECRET_KEY=CHANGE-ME-in-production
# 첫 기동 시 테이블 자동 생성(dev). 운영 전환 시 false + Alembic 마이그레이션.
AUTO_CREATE_TABLES=true
CORS_ORIGINS=["http://localhost:3000"]

# ── ERP dailylog read-only ──
# DB 담당자에게 접속정보 받으면 아래 채우기 → 재기동하면 실 ERP 자동 연동.
# 예: postgresql+asyncpg://readonly_user:password@erp-host:5432/dailylog
ERP_DATABASE_URL=

# ── 배치 스케줄러 (D17: APScheduler, G010) ──
# true면 backend가 EOD/KPI초안/ERP동기화 cron을 실제로 기동한다(운영 전환 시 켤 것).
SCHEDULER_ENABLED=false

# ── LiveKit 화상 (D24) ──
# key+secret 설정 시 회의 입장에 실 LiveKit AccessToken 발급 + FastAPI 경유 룸 생성/삭제 활성
# (미설정=결정적 stub 토큰). 아래 값은 docker-compose livekit 서비스의 기본 LIVEKIT_KEYS와 일치 —
# `docker compose --profile livekit up -d`로 기동하면 그대로 동작한다.
# - LIVEKIT_URL: compose 내부 네트워크는 ws://livekit:7880, 로컬 단독 실행은 ws://localhost:7880.
# - 운영 전환 시 devkey/devsecret는 강한 랜덤값으로 교체하고 compose LIVEKIT_KEYS도 함께 변경.
# 실 화상 미디어(WebRTC UDP)·Egress·STT는 별도 인프라 구성 필요(B-03).
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_at_least_32_chars_long__
