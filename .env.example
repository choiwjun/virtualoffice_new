# Docker Compose 환경변수 — 복사: cp .env.example .env (실제 .env는 커밋 금지)
# 사내 로컬 서버 PC 배포용

# ── PostgreSQL (우리 DB) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=virtualoffice
DB_PORT=5432
# 외부 공개 서버(VPN 없음) → DB는 localhost 전용. 절대 0.0.0.0으로 열지 말 것.
DB_BIND=127.0.0.1

# ── 백엔드 ──
BACKEND_PORT=8000
ENVIRONMENT=development
JWT_SECRET_KEY=CHANGE-ME-in-production
# 첫 기동 시 테이블 자동 생성(dev). 운영 전환 시 false + Alembic 마이그레이션.
AUTO_CREATE_TABLES=true
CORS_ORIGINS=["http://localhost:3000"]

# ── ERP dailylog read-only ──
# DB 담당자에게 접속정보 받으면 아래 채우기 → 재기동하면 실 ERP 자동 연동.
# 예: postgresql+asyncpg://readonly_user:password@erp-host:5432/dailylog
ERP_DATABASE_URL=

# ── 배치 스케줄러 (D17: APScheduler, G010) ──
# true면 backend가 EOD/KPI초안/ERP동기화 cron을 실제로 기동한다(운영 전환 시 켤 것).
SCHEDULER_ENABLED=false

# ── LiveKit 화상 (D24, B-03 슬라이스) ──
# key+secret 설정 시 회의 입장에 실 LiveKit AccessToken 발급(미설정=결정적 stub 토큰).
# self-host livekit/coturn은 `docker compose --profile livekit up`으로 기동. 실 화상/STT는 별도 구성(B-03).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
