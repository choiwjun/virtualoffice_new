# Docker Compose 환경변수 — 복사: cp .env.example .env (실제 .env는 커밋 금지)
# 사내 로컬 서버 PC 배포용 (D21-r: 단일 서버 PC, Caddy + Let's Encrypt, VPN 없음)
# D26: WorkAdventure self-host 본체 채택 (AGPL-3.0 + Commons Clause, 사내 도그푸딩)

# ── PostgreSQL (우리 DB) ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=virtualoffice
DB_PORT=5432
# 외부 공개 서버(VPN 없음) → DB는 localhost 전용. 절대 0.0.0.0으로 열지 말 것.
DB_BIND=127.0.0.1

# ── FastAPI 백엔드 ────────────────────────────────────────────────────
ENVIRONMENT=production
JWT_SECRET_KEY=CHANGE-ME-in-production
# Caddy가 역방향 프록시 담당 → backend는 expose만 (포트 직접 오픈 불필요)
AUTO_CREATE_TABLES=true
CORS_ORIGINS=["https://office.example.com","https://api.office.example.com"]

# ── ERP dailylog read-only ─────────────────────────────────────────────
# DB 담당자에게 접속정보 받으면 아래 채우기 → 재기동하면 실 ERP 자동 연동.
# 예: postgresql+asyncpg://readonly_user:password@erp-host:5432/dailylog
ERP_DATABASE_URL=

# ── WorkAdventure 스택 (D26) ──────────────────────────────────────────
# WorkAdventure Docker 이미지 버전 (릴리스 목록: github.com/workadventure/workadventure/releases)
# ⚠️ "master"는 브레이킹 체인지 위험 → 반드시 구체적 버전 태그 사용
WA_VERSION=v1.21.5

# WorkAdventure 메인 시크릿 (JWT 세션 서명·스크립팅 API 변수 암호화)
# 충분히 길고 랜덤한 값 필요 (예: openssl rand -hex 32)
WA_SECRET_KEY=CHANGE-ME-wa-secret-key-32chars-min

# WorkAdventure 메인 도메인 (브라우저가 접속하는 주소)
WA_DOMAIN=office.example.com

# FastAPI 백엔드 도메인 (WorkAdventure OIDC Provider + 관리 API)
# Caddy가 이 도메인을 backend:8000으로 라우팅
WA_API_DOMAIN=api.office.example.com

# map-storage 관리자 자격증명 (맵 업로드 클라이언트용 Basic 인증)
WA_MAP_STORAGE_USER=admin
WA_MAP_STORAGE_PASSWORD=CHANGE-ME-map-storage-password

# WorkAdventure 입장 URL (초기 맵; map-storage에 업로드한 후 변경)
# 형식: /_/global/<맵호스트>/<경로>.tmj  또는  /~/wam파일.wam
WA_START_ROOM_URL=/_/global/workadventure.github.io/map-starter-kit/office.tmj

# 익명 접근 비활성화 (true 권장 — ERP 사용자만 입장, D26)
WA_DISABLE_ANONYMOUS=true

# 버블당 최대 인원 — 4 이상이면 LiveKit SFU 사용 (설정값 = LiveKit 전환 임계값)
WA_MAX_PER_GROUP=4

# 기타 옵션
WA_MAX_USERNAME_LENGTH=20
WA_ENABLE_MAP_EDITOR=true
WA_ENABLE_CHAT=true
WA_ENABLE_CHAT_UPLOAD=true
WA_UPLOAD_MAX_FILESIZE=10485760
# 맵 편집기 허용 사용자 이메일 (쉼표 구분; OIDC email 클레임과 일치해야 함)
WA_MAP_EDITOR_USERS=

# ── WorkAdventure OIDC — FastAPI를 OIDC Provider로 사용 (D26 Lane C) ──
# FastAPI backend의 integrations/workadventure/oidc.py 가 OIDC 브리지 제공.
# WA_OIDC_ISSUER = WA_API_DOMAIN 기반 Well-Known URL
# (예: https://api.office.example.com)
WA_OIDC_CLIENT_ID=workadventure
WA_OIDC_CLIENT_SECRET=CHANGE-ME-oidc-client-secret
WA_OIDC_ISSUER=https://api.office.example.com
# backend에서 OIDC 브리지를 노출할 기준 URL
WA_OIDC_BASE_URL=https://api.office.example.com

# ── LiveKit SFU (화상/음성 그룹 통화, D26) ───────────────────────────
# API 키: 영숫자로 시작하는 임의 문자열 (예: APIxxxxxxxxxxxxxxxx)
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
# API 시크릿: 충분히 긴 랜덤 문자열 (예: openssl rand -hex 32)
LIVEKIT_API_SECRET=CHANGE-ME-livekit-api-secret
# LiveKit 공개 도메인 (브라우저가 SFU에 직접 WebSocket 연결)
LIVEKIT_DOMAIN=livekit.office.example.com

# ── coturn TURN 서버 (P2P WebRTC 릴레이, D21-r TURN-TLS 폴백) ────────
# 정적 시크릿 방식 — 브라우저에 자격증명 노출 없이 시간 제한 토큰 사용 (보안 권장)
# ⚠️ config/coturn.conf 의 REPLACE_WITH_COTURN_STATIC_SECRET 와 동일한 값으로 설정
COTURN_STATIC_SECRET=CHANGE-ME-coturn-static-secret

# TURN 서버 URL (WorkAdventure play/back 에서 클라이언트에 전달)
# 5349 = TLS TURN 표준 포트 (D21-r TURN-TLS 폴백)
WA_TURN_SERVER=turn:office.example.com:5349

# STUN 서버 (기본: Google STUN; 사내망 제한 시 자체 STUN 사용)
WA_STUN_SERVER=stun:stun.l.google.com:19302

# ── Caddy 역방향 프록시 (D21-r: Caddy + Let's Encrypt) ────────────────
# Let's Encrypt 인증서 발급용 이메일 (갱신 만료 경고 수신)
ACME_EMAIL=admin@example.com
