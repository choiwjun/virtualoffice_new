# Docker Compose 환경변수 — 복사: cp .env.example .env (실제 .env는 커밋 금지)
# 사내 로컬 서버 PC 배포용 (D21-r: 단일 서버 PC, Caddy + Let's Encrypt, VPN 없음)
# D29/D30: 2.5D 웹임베드 단일 통합 스택 (WorkAdventure/D26 폐기, 2026-07-17 재작성)
#
# ⚠️ 오픈 전(spec-gap-audit P0/P1): ENVIRONMENT=production 이면 backend·realtime이
#    dev 기본 시크릿 기동을 거부(fail-fast). 아래 CHANGE-ME 값을 전부 강한 랜덤으로 교체.
#    강한 값 생성 예:
#      openssl rand -hex 32                         # JWT/INTERNAL/LiveKit/coturn
#      python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  # INTEGRATION_ENCRYPTION_KEY

# ── 배포 환경 ─────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── PostgreSQL (우리 DB) ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=virtualoffice
DB_PORT=5432
# 외부 공개 서버(VPN 없음) → DB는 localhost 전용. 절대 0.0.0.0으로 열지 말 것.
DB_BIND=127.0.0.1

# ── 도메인 (Caddy TLS 라우팅) ─────────────────────────────────────────
APP_DOMAIN=office.example.com               # 웹콘솔 + /api/*(backend)
REALTIME_DOMAIN=realtime.office.example.com # Colyseus 이동서버 WS
LIVEKIT_DOMAIN=livekit.office.example.com   # LiveKit SFU
# 브라우저에 각인되는 공개 URL(frontend 빌드 build-arg)
APP_PUBLIC_URL=https://office.example.com
REALTIME_PUBLIC_URL=wss://realtime.office.example.com

# ── FastAPI 백엔드 보안 시크릿 (P1) ───────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-jwt-secret-openssl-rand-hex-32
INTERNAL_API_TOKEN=CHANGE-ME-internal-token-openssl-rand-hex-32
# D31 외부 계정 토큰 at-rest 암호화 (Fernet urlsafe base64 32B) — 필수(P1-5)
INTEGRATION_ENCRYPTION_KEY=CHANGE-ME-fernet-generate-key
AUTO_CREATE_TABLES=true
CORS_ORIGINS=["https://office.example.com"]
# 로그인 rate-limit (P1-2) — Caddy 뒤라 프록시 IP 헤더 신뢰
TRUST_PROXY_IP_HEADER=true
LOGIN_RATE_LIMIT_PER_MIN=10

# ── 실시간 이동서버 (Colyseus, P1-4) ──────────────────────────────────
# production은 JWT_REQUIRED=true 필수(무인증 join 금지). JWT_SECRET은 백엔드와 동일값.
JWT_REQUIRED=true
SCENE_FLOOR=horizon

# ── ERP dailylog read-only ─────────────────────────────────────────────
# DB 담당자에게 접속정보 받으면 아래 채우기 → 재기동하면 실 ERP 자동 연동.
# 예: postgresql+asyncpg://readonly_user:password@erp-host:5432/dailylog
ERP_DATABASE_URL=

# ── LiveKit SFU (회의 화상/음성, D24) ─────────────────────────────────
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=CHANGE-ME-livekit-api-secret-openssl-rand-hex-32
# 브라우저가 아닌 backend가 접근할 LiveKit URL(회의 토큰 발급 응답에 실림)
LIVEKIT_PUBLIC_URL=https://livekit.office.example.com

# ── coturn TURN 서버 (P2P WebRTC 릴레이, D21-r TURN-TLS 폴백) ────────
# ⚠️ config/coturn.conf 의 REPLACE_WITH_COTURN_STATIC_SECRET 와 동일한 값으로 설정
COTURN_STATIC_SECRET=CHANGE-ME-coturn-static-secret

# ── Caddy 역방향 프록시 (D21-r: Caddy + Let's Encrypt) ────────────────
ACME_EMAIL=admin@example.com
