# Caddyfile — 가상오피스 역방향 프록시 (D26 WorkAdventure 전환 후)
# D21-r: Caddy + Let's Encrypt, 단일 서버 PC, VPN 없음
#
# 도메인 구성 예시:
#   WA_DOMAIN=office.example.com        → WorkAdventure (play/back/map-storage/uploader/icon)
#   WA_API_DOMAIN=api.office.example.com → FastAPI 백엔드 (OIDC provider + management API)
#   LIVEKIT_DOMAIN=livekit.office.example.com → LiveKit SFU 공개 엔드포인트
#
# 환경변수는 .env에서 Caddy 서비스의 environment 섹션을 통해 주입됨.
# 개발(도메인 없음) 시 TLS 지시어를 제거하고 http:// 로 사용.

# ── WorkAdventure 메인 도메인 ─────────────────────────────────────────
{$WA_DOMAIN} {
	tls {$ACME_EMAIL}

	# WebSocket 연결 (play 서버 WS pusher — sticky 불필요, 단일 인스턴스)
	@ws {
		path /ws/*
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy wa-play:3001
	}

	# WorkAdventure back HTTP API (REST)
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy wa-back:8080
	}

	# map-storage (TMJ 맵 파일 업로드·조회)
	handle /map-storage/* {
		uri strip_prefix /map-storage
		reverse_proxy wa-map-storage:3000
	}

	# uploader (채팅 파일 업로드)
	handle /uploader/* {
		uri strip_prefix /uploader
		reverse_proxy wa-uploader:8080
	}

	# iconserver (iframe favicon 프록시)
	handle /icon/* {
		uri strip_prefix /icon
		reverse_proxy wa-icon:8080
	}
	handle /lettericons/* {
		reverse_proxy wa-icon:8080
	}

	# 기본 → play (정적 에셋 + 게임 진입점)
	handle {
		reverse_proxy wa-play:3000
	}
}

# ── FastAPI 백엔드 도메인 (OIDC Provider + Management API) ───────────
# D26: FastAPI가 WorkAdventure의 OIDC 제공자 역할 수행 (Lane C oidc.py)
{$WA_API_DOMAIN} {
	tls {$ACME_EMAIL}
	reverse_proxy backend:8000
}

# ── LiveKit SFU 공개 엔드포인트 (브라우저 ↔ LiveKit 시그널링) ─────────
# 브라우저가 직접 LiveKit에 WebSocket 연결 (SFU 방식, 4인 이상 버블)
{$LIVEKIT_DOMAIN} {
	tls {$ACME_EMAIL}
	reverse_proxy livekit:7880
}
