# Caddyfile — 가상오피스 역방향 프록시 (D29/D30 단일 통합 스택, 2026-07-17 재작성)
# D21-r: Caddy + Let's Encrypt, 단일 서버 PC, VPN 없음
#
# 도메인 구성 예시:
#   APP_DOMAIN=office.example.com            → Next.js 웹콘솔(root) + /api/*(FastAPI backend)
#   REALTIME_DOMAIN=realtime.office.example.com → Colyseus 이동서버 WS (2567)
#   LIVEKIT_DOMAIN=livekit.office.example.com   → LiveKit SFU 공개 엔드포인트 (7880)
#
# 환경변수는 .env → docker-compose caddy 서비스 environment로 주입.
# 개발(도메인 없음) 시 TLS 지시어를 제거하고 http:// 로 사용.

# ── 웹콘솔 메인 도메인 (frontend + backend /api) ──────────────────────
{$APP_DOMAIN} {
	tls {$ACME_EMAIL}

	# 로그인 브루트포스 1차 차단(P1-2) — IP당 분당 제한. 앱단(미들웨어)이 2차 방어.
	# (Caddy 기본 빌드에 rate_limit 미포함 시 이 블록은 무시되고 앱단 제한만 적용됨.
	#  운영은 caddy-ratelimit 플러그인 포함 이미지를 쓰거나 이 블록을 활성화한다.)
	# rate_limit {
	# 	zone login {
	# 		match { path /api/auth/login }
	# 		key {remote_host}
	# 		events 10
	# 		window 1m
	# 	}
	# }

	# FastAPI 백엔드 — /api/* (라우터가 /api prefix 포함하므로 strip 금지)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# 나머지 → Next.js 웹콘솔 (SSR/정적/HMR 없음, standalone server.js)
	handle {
		reverse_proxy frontend:3000
	}
}

# ── Colyseus 실시간 이동서버 (브라우저 ↔ WS, 20Hz) ────────────────────
# colyseus.js 는 /matchmake/* (HTTP) + WebSocket upgrade를 사용 — Caddy가 둘 다 프록시.
{$REALTIME_DOMAIN} {
	tls {$ACME_EMAIL}
	reverse_proxy realtime:2567
}

# ── LiveKit SFU 공개 엔드포인트 (브라우저 ↔ LiveKit 시그널링) ─────────
{$LIVEKIT_DOMAIN} {
	tls {$ACME_EMAIL}
	reverse_proxy livekit:7880
}
