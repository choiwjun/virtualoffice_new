# Caddyfile.local — 로컬 확인 전용 (커밋/배포 대상 아님)
# http 단일 오리진, TLS 없음(localhost = secure context). WA UI/맵/이동 미리보기용.
# auth.localhost:8090 블록: OIDC 디스커버리·토큰 엔드포인트를 backend:8000에 위임.
{
	admin off
	auto_https off
}

# ── WA 메인 스택 — http://localhost:8090 ──────────────────────────────
# host를 localhost로 한정해 auth.localhost:8090 사이트 블록과 충돌하지 않도록 함.
http://localhost:8090 {
	# WebSocket (play pusher)
	@ws {
		path /ws/*
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy wa-play:3001
	}

	# FastAPI 백엔드 presence 엔드포인트 (same-origin 유지 — WA iframe 스크립트가 호출)
	# /api/* 일반 라우트(wa-back)보다 먼저 매칭되어야 하므로 앞에 배치.
	handle /api/wa/presence {
		reverse_proxy backend:8000
	}

	# FastAPI 백엔드 LiveKit 토큰 엔드포인트 (wa-livekit.router)
	handle /api/wa/livekit-token {
		reverse_proxy backend:8000
	}
	# FastAPI 백엔드 인증 엔드포인트 (웹콘솔, D4 JWT HS256)
	# /api/* strip_prefix 블록보다 먼저 매칭되어야 하므로 앞에 배치.
	handle /api/auth/* {
		reverse_proxy backend:8000
	}


	handle /api/* {
		uri strip_prefix /api
		reverse_proxy wa-back:8080
	}

	handle /map-storage/* {
		uri strip_prefix /map-storage
		reverse_proxy wa-map-storage:3000
	}

	handle /uploader/* {
		uri strip_prefix /uploader
		reverse_proxy wa-uploader:8080
	}

	handle /icon/* {
		uri strip_prefix /icon
		reverse_proxy wa-icon:8080
	}
	handle /lettericons/* {
		reverse_proxy wa-icon:8080
	}

	# ── LiveKit SFU WebSocket — /livekit/* ─────────────────────────────
	# 브라우저가 ws://localhost:8090/livekit/* 로 LiveKit WebSocket에 연결.
	# wa-back은 http://livekit:7880 (Docker 내부 DNS) 직접 사용 → 이 경로는 브라우저 전용.
	# 로컬 제약: HTTP (TLS 없음). 프로덕션에서는 wss:// 도메인으로 교체.
	handle /livekit/* {
		uri strip_prefix /livekit
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy wa-play:3000
	}
}

# ── OIDC Provider — http://auth.localhost:8090 ────────────────────────
# FastAPI backend(port 8000)를 OIDC Provider로 노출.
# WA play 컨테이너와 브라우저 양쪽에서 동일 URL로 접근 가능:
#   브라우저: auth.localhost → 127.0.0.1:8090(published) → 이 블록 → backend:8000
#   WA 컨테이너: auth.localhost → Docker DNS(caddy alias) → 이 블록 → backend:8000
http://auth.localhost:8090 {
	reverse_proxy backend:8000
}
