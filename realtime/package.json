    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.14.9",
    "colyseus.js": "^0.15.28",
    "tsx": "4.16.2",
    "typescript": "5.5.3"
  }
