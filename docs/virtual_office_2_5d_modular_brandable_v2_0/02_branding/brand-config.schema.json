{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Virtual Office Brand Config",
  "type": "object",
  "required": [
    "companyName",
    "subtitle"
  ],
  "properties": {
    "companyName": {
      "type": "string",
      "maxLength": 28
    },
    "subtitle": {
      "type": "string",
      "maxLength": 36
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "logoUrl": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}