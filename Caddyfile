# 가상오피스 외부 공개 하드닝 리버스 프록시 (P2-R4-T1, D21-r / HG-SEC)
#
# 단일 진입점: Caddy만 80/443을 공개하고, backend(8000)·web(3000)은 내부 네트워크로만 노출한다.
# TLS: {$VO_DOMAIN} 설정 시 Let's Encrypt 자동 발급(ACME). 미설정(:80)은 사내 도그푸딩 임시용.
#
# 활성화: .env에 VO_DOMAIN/ACME_EMAIL 설정 후 `docker compose --profile edge up -d`.
# 잔여(런타임 검증): 포트 스캔, 실 rate-limit 부하 테스트, fail2ban(호스트 레벨)은 배포 후 수행(HG-SEC).

{
	email {$ACME_EMAIL:admin@spacecl.com}
	# rate-limit는 표준 빌드 미포함 플러그인 → 호스트 레벨 fail2ban + 아래 요청 크기/타임아웃으로 1차 방어.
	servers {
		timeouts {
			read_body 10s
			read_header 5s
			idle 120s
		}
		max_header_size 16kb
	}
}

{$VO_DOMAIN::80} {
	encode gzip zstd

	# 보안 헤더(HG-SEC 체크리스트).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# 요청 본문 상한(대용량 업로드 남용 방어).
	request_body {
		max_size 10MB
	}

	# API/웹훅은 backend로, 나머지(웹 콘솔)는 web(Next.js)로 라우팅.
	# management-api 계약: 외부 /api/* → 내부 /* (D21-r).
	handle_path /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	handle /console* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
